{
  "name": "ontology-learning-platform",
  "version": "1.0.0",
  "description": "本体智能教学平台 - AI 本体论与共享模型",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "next lint",
    "verify:cases": "tsx scripts/verify-cases.ts",
    "gen:cases": "tsx scripts/gen-case-library.ts",
    "verify:simulation": "node --import tsx scripts/verify-simulation.ts",
    "verify:handbook": "node --import tsx scripts/verify-handbook.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "gray-matter": "4.0.3",
    "lucide-react": "0.408.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "9.0.1",
    "rehype-highlight": "7.0.0",
    "remark-gfm": "4.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@types/node": "20.14.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.4",
    "tsx": "4.19.2",
    "typescript": "5.5.3",
    "wrangler": "^4.154.0"
  }
}